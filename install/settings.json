{
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "model": "opus",
  "tui": "fullscreen",
  "modelSettings": { "claude-opus-5-5": { "autoCompactWindow": 400000 } },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "statusLine": { "type": "command", "command": "bash \"{{CLAUDE_DIR}}/scripts/statusline.sh\"" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{CLAUDE_DIR}}/hooks/biome-push-check.sh\"",
            "if": "Bash(git push*)",
            "timeout": 180,
            "statusMessage": "Running Biome before push"
          }
        ]
      }
    ]
  }
}
