language js

JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=or {
  JsArrowFunctionExpression(),
  JsFunctionExpression()
})) as $component where {
  $name <: r"[A-Z][A-Za-z0-9]*",
  not $component <: within or {
    JsFunctionBody(),
    JsArrowFunctionExpression(),
    JsClassDeclaration(),
    JsObjectExpression()
  },
  $filename <: r".*/([^/]+)\.[jt]sx"($base),
  $flat = lowercase($name),
  $parts = split($base, "-"),
  $joined = join(list=$parts, separator=""),
  or {
    not $base <: r"[a-z0-9]+(?:-[a-z0-9]+)*",
    not $joined <: $flat,
    and {
      not $name <: r"[\s\S]*[A-Z][A-Z][\s\S]*",
      or {
        and { $parts <: [$a], $pascal = capitalize($a), not $name <: $pascal },
        and {
          $parts <: [$a, $b],
          $pascal = join(list=[capitalize($a), capitalize($b)], separator=""),
          not $name <: $pascal
        },
        and {
          $parts <: [$a, $b, $c],
          $pascal = join(list=[capitalize($a), capitalize($b), capitalize($c)], separator=""),
          not $name <: $pascal
        },
        and {
          $parts <: [$a, $b, $c, $d],
          $head = join(list=[capitalize($a), capitalize($b), capitalize($c)], separator=""),
          $tail = join(list=[capitalize($d)], separator=""),
          $pascal = join(list=[$head, $tail], separator=""),
          not $name <: $pascal
        },
        and {
          $parts <: [$a, $b, $c, $d, $e],
          $head = join(list=[capitalize($a), capitalize($b), capitalize($c)], separator=""),
          $tail = join(list=[capitalize($d), capitalize($e)], separator=""),
          $pascal = join(list=[$head, $tail], separator=""),
          not $name <: $pascal
        },
        and {
          $parts <: [$a, $b, $c, $d, $e, $f],
          $head = join(list=[capitalize($a), capitalize($b), capitalize($c)], separator=""),
          $tail = join(list=[capitalize($d), capitalize($e), capitalize($f)], separator=""),
          $pascal = join(list=[$head, $tail], separator=""),
          not $name <: $pascal
        }
      }
    }
  },
  register_diagnostic(span=$name, message=`R-one-component file $base should be the kebab-case of $name (CMP-1)`)
}
